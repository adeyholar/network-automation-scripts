# Copy to .env (never commit .env) or export these in your shell.
# Values below are placeholders only.

# TLS for all PAN-OS tools (verification is on by default)
# NET_SCRIPTS_CA_BUNDLE=/path/to/management-ca.pem
# NET_SCRIPTS_VERIFY_TLS=false   # lab only; prints a warning

# Palo Alto PAN-OS (policy-api)
NET_SCRIPTS_API_TOKEN=change-me-to-a-long-random-value
NET_SCRIPTS_WORK_DIR=./output
PANOS_HOST=192.0.2.1
PANOS_USERNAME=admin
PANOS_PASSWORD=change-me

# VMware VeloCloud Orchestrator
VCO_URL=https://orchestrator.example.com
VCO_API_TOKEN=change-me
VCO_USERNAME=change-me
VCO_PASSWORD=change-me

# Flask web UI (config-change-webapp)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
FLASK_SECRET_KEY=change-me
FLASK_MAX_UPLOAD_MB=20

# PowerShell network scan output folder (optional)
NETSCAN_OUTPUT_DIR=

# FortiGate runbook output file (optional)
OUTPUT_DOCX=FortiGate_IPsec_VPN_Implementation.docx
